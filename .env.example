# Salin file ini menjadi .env untuk pengembangan lokal:
#   cp .env.example .env
#
# .env sudah masuk .gitignore - JANGAN pernah di-commit.

# Kunci penandatangan cookie sesi. WAJIB ada, kalau kosong aplikasi akan
# melempar error saat start (netlify/functions/bootstrap.mjs).
#
# Buat nilai acak yang panjang. Contoh:
#   openssl rand -base64 32
#   # atau di PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=

# Saat deploy, set nilai yang sama di:
#   Netlify > Site configuration > Environment variables > SESSION_SECRET
#
# Kalau site's Blobs store sudah punya secret-nya sendiri, @netlify/blobs
# menyediakannya lewat NETLIFY_BLOBS_SESSION_SECRET. Tetap disarankan set
# manual supaya tidak bergantung pada konfigurasi otomatis.
